# Privacy-first default: Ollama's local OpenAI-compatible endpoint. Scholar
# Flow never infers a provider and never falls back to OCI after an error.
#
# `local_llama` is the existing internal name for Scholar Flow's local,
# loopback-only provider. In this handoff it is configured for Ollama.
SCHOLAR_FLOW_AI_PROVIDER=local_llama
SCHOLAR_FLOW_MODE=offline
SCHOLAR_FLOW_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Set this to an exact installed name from `ollama list`.
SCHOLAR_FLOW_OLLAMA_MODEL=llama3.2
# This is Scholar Flow's prompt budget. To change the model's actual Ollama
# context window, create an Ollama model with the required num_ctx setting.
SCHOLAR_FLOW_OLLAMA_CONTEXT_TOKENS=32768
SCHOLAR_FLOW_OLLAMA_MAX_OUTPUT_TOKENS=8192
SCHOLAR_FLOW_OLLAMA_VISION_ENABLED=false
ORESOLVE_GENAI_ENABLED=false

# Required server-only HMAC secrets. Each must be 32–1,024 UTF-8 bytes and the
# values must differ. Provider credentials are never accepted as signing keys.
SCHOLAR_FLOW_GUIDELINE_SIGNING_SECRET=
SCHOLAR_FLOW_CORPUS_SIGNING_SECRET=

# PDF compilation stays loopback-only and cached-only in both provider modes.
SCHOLAR_FLOW_LATEX_COMPILER_URL=http://127.0.0.1:3101/compile
SCHOLAR_FLOW_LATEX_COMPILER_TOKEN=
TECTONIC_ONLY_CACHED=1
