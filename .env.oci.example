# Optional OCI cloud-testing provider. Copy this file to a private .env.local
# only when deliberately switching away from local Llama. Research materials
# leave this computer while this provider is active.
SCHOLAR_FLOW_AI_PROVIDER=oci
SCHOLAR_FLOW_MODE=cloud
ORESOLVE_GENAI_ENABLED=true
ORESOLVE_GENAI_API_KEY=
ORESOLVE_GENAI_REGION=us-ashburn-1
ORESOLVE_GENAI_TRANSPORT=chat
ORESOLVE_GENAI_PROJECT_ID=
ORESOLVE_GENAI_MODEL=google.gemini-2.5-flash
ORESOLVE_GENAI_MAX_OUTPUT_TOKENS=65536
ORESOLVE_GENAI_BASE_URL=https://inference.generativeai.us-ashburn-1.oci.oraclecloud.com/openai/v1

# Required server-only HMAC secrets. Each must be 32–1,024 UTF-8 bytes and the
# values must differ. Provider credentials are never accepted as signing keys.
SCHOLAR_FLOW_GUIDELINE_SIGNING_SECRET=
SCHOLAR_FLOW_CORPUS_SIGNING_SECRET=

# PDF compilation remains loopback-only.
SCHOLAR_FLOW_LATEX_COMPILER_URL=http://127.0.0.1:3101/compile
SCHOLAR_FLOW_LATEX_COMPILER_TOKEN=
TECTONIC_ONLY_CACHED=1
